                          ';border-left:3px solid ' + kolor + '">' +
                          '<span class="ico">' + ico + '</span> ' + opis + '</td>' +
                        '</tr>';
                    }).join('');


                    const okres = fmtD(pom[pom.length - 1].dt) + ' – ' +
                    fmtD(pom[0].dt);


                    const html = `<!DOCTYPE html><html lang="pl"><head><meta
                    charset="utf-8">

                    <title>Pomiary ciśnienia — ${okres}</title>

                    <style>
                      @page { size: A4 portrait; margin: 12mm; }
