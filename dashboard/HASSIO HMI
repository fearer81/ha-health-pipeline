                      Pomiary własne wykonane ciśnieniomierzem Omron M4 Intelli IT (walidowany klinicznie),
                      eksport automatyczny bez ręcznej edycji. Klasyfikacja wg wytycznych ESC/ESH.
                    </div>

                    </body></html>`;


                    const w = window.open('', '_blank');

                    if (!w) { alert('Przeglądarka zablokowała nowe okno — zezwól
                    na wyskakujące okienka.'); return; }

                    w.document.write(html);

                    w.document.close();
