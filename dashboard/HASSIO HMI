            tap_action:
              action: fire-dom-event
              browser_mod:
                service: browser_mod.javascript
                data:
                  code: >
                    const DNI_WSTECZ = 30;

                    const all =
                    hass.states['sensor.omron_m4_history'].attributes.rows ||
                    [];

                    const prog = Date.now() / 1000 - DNI_WSTECZ * 86400;


                    const kat = (s, d) => {
                      if (s >= 180 || d >= 110) return ['⛔', 'S3 — nadciśnienie 3. stopnia', '#8e1b12', '#fbe3e0'];
                      if (s >= 160 || d >= 100) return ['🔴', 'S2 — nadciśnienie 2. stopnia', '#b03a2e', '#fdeae7'];
                      if (s >= 140 || d >=  90) return ['🟠', 'S1 — nadciśnienie 1. stopnia', '#a04000', '#fdf0e3'];
                      if (s >= 130 || d >=  85) return ['🟡', 'Wysokie prawidłowe', '#8a6d00', '#fdf8e1'];
                      if (s >= 120 || d >=  80) return ['🔵', 'Prawidłowe', '#1f6391', '#e8f2fa'];
                      if (s <   90 || d <   60) return ['🟣', 'Hipotonia', '#6c3483', '#f3e9f7'];
                      return ['🟢', 'Optymalne', '#1e7e45', '#e6f5ec'];
                    };


                    const ppOcena = (v) => {
                      if (v >= 60) return ['💔', 'wysokie', '#b03a2e'];
                      if (v >= 50) return ['🧡', 'podwyższone', '#a04000'];
                      if (v >= 40) return ['💚', 'prawidłowe', '#1e7e45'];
                      return ['💙', 'niskie', '#1f6391'];
                    };


                    const pom = [];

                    all.forEach(r => {
                      if (r.n === 0 || !r.pressure || r.ts < prog) return;
                      const p = String(r.pressure).replace(' mmHg', '').split('/');
                      const s = parseInt(p[0], 10), d = parseInt(p[1], 10);
                      if (isNaN(s) || isNaN(d)) return;
                      const dt = new Date(r.ts * 1000);
                      pom.push({
                        dt: dt, s: s, d: d, pp: s - d,
                        puls: r.pulse ? parseInt(String(r.pulse).replace(' bpm', ''), 10) : null,
                        rano: dt.getHours() < 12
                      });
                    });

                    pom.sort((a, b) => b.dt - a.dt);


                    if (!pom.length) { alert('Brak pomiarów w wybranym
                    okresie.'); return; }


                    const sr = (arr, k) => {
                      const v = arr.map(x => x[k]).filter(x => x !== null && !isNaN(x));
                      return v.length ? Math.round(v.reduce((a, b) => a + b, 0) / v.length) : '—';
                    };

                    const fmtD = (dt) => String(dt.getDate()).padStart(2,'0') +
                    '.' +
                                         String(dt.getMonth()+1).padStart(2,'0') + '.' + dt.getFullYear();
                    const fmtT = (dt) => String(dt.getHours()).padStart(2,'0') +
                    ':' +
                                         String(dt.getMinutes()).padStart(2,'0');

                    const ranne = pom.filter(x => x.rano);

                    const wiecz = pom.filter(x => !x.rano);

                    const podw = pom.filter(x => x.s >= 140 || x.d >=
                    90).length;


                    const licz = {};

                    pom.forEach(x => {
                      const k = kat(x.s, x.d);
