                      if (!licz[key]) licz[key] = { n: 0, ico: k[0], kolor: k[2], tlo: k[3] };
                      licz[key].n++;
                    });

                    const rozklad = Object.entries(licz).sort((a, b) => b[1].n -
                    a[1].n)
