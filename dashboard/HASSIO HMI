                      .box { border:1px solid #ccc; border-radius:6px; padding:10px 12px; margin-bottom:14px; }
                      .grid { display:flex; gap:26px; flex-wrap:wrap; margin-bottom:8px; }
                      .kpi { min-width:100px; }
                      .kpi .lbl { font-size:8.5pt; color:#666; text-transform:uppercase; letter-spacing:.4px; }
                      .kpi .val { font-size:17pt; font-weight:bold; line-height:1.15; }
                      .kpi .val small { font-size:9pt; font-weight:normal; color:#666; }
                      .pill { display:inline-block; border-radius:10px; padding:2px 9px;
                              font-size:9pt; margin:2px 3px 2px 0; font-weight:600; }
                      table { width:100%; border-collapse:collapse; font-size:9.5pt; }
                      th { background:#f2f2f2; text-align:left; padding:5px 6px;
                           border-bottom:2px solid #999; font-size:8.5pt;
                           text-transform:uppercase; letter-spacing:.3px; }
                      td { padding:4px 6px; border-bottom:1px solid #e8e8e8; }
                      td.num, th.num { text-align:center; }
                      td.cis { font-size:10.5pt; white-space:nowrap; }
                      td.kat { font-weight:600; }
                      .ico { font-size:10pt; }
                      tbody tr:nth-child(even) { background:#fafafa; }
                      thead { display:table-header-group; }
                      tr { page-break-inside:avoid; }
                      .stopka { margin-top:12px; font-size:8pt; color:#888;
                                border-top:1px solid #ddd; padding-top:6px; }
                      .noprint { margin-bottom:14px; }
                      @media print { .noprint { display:none; } body { font-size:10pt; } }
                    </style></head><body>

                    <div class="noprint">
                      <button onclick="window.print()" style="padding:8px 18px;font-size:14px;cursor:pointer">
                        🖨️ Drukuj / zapisz jako PDF</button>
                    </div>

                    <h1>Pomiary ciśnienia tętniczego</h1>

                    <div class="sub">Okres: <b>${okres}</b> &nbsp;•&nbsp;
