                    const wiersze = pom.map(x => {
                      const [ico, opis, kolor, tlo] = kat(x.s, x.d);
                      const [pIco, pOpis, pKolor] = ppOcena(x.pp);
                      return '<tr>' +
                        '<td>' + fmtD(x.dt) + '</td>' +
                        '<td>' + fmtT(x.dt) + '</td>' +
                        '<td class="num cis"><b>' + x.s + '</b> / <b>' + x.d + '</b></td>' +
