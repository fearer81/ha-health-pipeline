type: custom:flex-table-card
sort_by: ts-
entities:
  include:
    - sensor.omron_m4_history
columns:
  - name: 🕒<br><small>Data i Czas</small>
    data: rows
    modify: |-
      (function(){
        let t = String(x.time);
        if (t.includes('-')) {
          let p = t.split(' ');
          let d = p[0].split('-');
          return d[2] + '.' + d[1] + ' ' + p[1].substring(0,5);
        }
        return t.replace('.2026', '');
      })()
  - name: 🩺<br><small>Ciśnienie</small>
    data: rows
    modify: "x.n === 0 ? '📡' : (x.pressure ? x.pressure.replace(' mmHg','') : '---')"
    align: center
  - name: 🚦<br><small>S0-3</small>
    data: rows
    modify: |-
      (function(){
        if (!x.pressure) return '---';
        var p = x.pressure.split('/');
        var s = parseInt(p[0]); var d = parseInt(p[1]);
        if (s >= 180 || d >= 110) return '⛔S3';
        if (s >= 160 || d >= 100) return '🔴S2';
        if (s >= 140 || d >=  90) return '🟠S1';
        if (s >= 130 || d >=  85) return '🟡S0';
        if (s >= 120 || d >=  80) return '🔵 Pr';
        return '🟢 Pr';
      })()
    align: center
  - name: 💢<br><small>Ro-Sk</small>
    data: rows
    modify: |-
      (function(){
        if (!x.pressure) return '---';
        var p = x.pressure.split('/');
        var s = parseInt(p[0]);
        var d = parseInt(p[1]);
        var pp = s - d;
        if (pp >= 60) return pp + '🔴';
        if (pp >= 50) return pp + '🟡';
        if (pp >= 40) return pp + '🟢';
        return pp + '💚';
      })()
    align: center
  - name: ❤️<br><small>Tęt.</small>
    data: rows
    modify: |-
      (function(){
        // Priorytet: puls z Omrona (pomiar mankietowy)
        if (x.pulse) return x.pulse.replace(' bpm','');
        // Fallback: RHR z Garmina (tętno spoczynkowe z doby) — oznaczony ⌚
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));
          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';
          return closest.rhr ? closest.rhr + '⌚' : '---';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: 🧗<br><small>Str.</small>
    data: rows
    modify: |-
      (function(){
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));
          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';
          return closest.stress || '---';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: ⚡<br><small>BB</small>
    data: rows
    modify: |-
      (function(){
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));
          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';
          return closest.bb || '---';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: 💤<br><small>TSpo</small>
    data: rows
    modify: |-
      (function(){
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));
          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';
          return closest.rhr || '---';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: 🛌<br><small>Sen</small>
    data: rows
    modify: |-
      (function(){
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();

          // Funkcja dopasowująca czas (ls musi istnieć w danych)
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));

          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';

          // Poprawka: sprawdzamy czy ss w ogóle istnieje, a nie czy jest > 0
          let score = (closest.ss !== undefined) ? closest.ss : '---';
          let hours = (closest.sh !== undefined) ? closest.sh : '0';
          return score + '/' + hours + 'h';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: 🔄<br><small>Sync</small>
    data: rows
    modify: |-
      (function(){
        try {
          const gHist = document.querySelector("home-assistant").hass.states['sensor.garmin_history'];
          const gRows = gHist.attributes.rows;
          const omronTime = new Date(x.ts * 1000).getTime();
          const getLsTs = (r) => new Date(r.ls.replace('T', ' ').split('.')[0]).getTime();
          const closest = gRows.reduce((prev, curr) => (Math.abs(getLsTs(curr) - omronTime) < Math.abs(getLsTs(prev) - omronTime) ? curr : prev));
          if (Math.abs(getLsTs(closest) - omronTime) > 14 * 3600000) return '---';
          const ls = String(closest.ls);
          const timePart = ls.includes('T') ? ls.split('T')[1] : ls.split(' ')[1];
          return timePart ? timePart.substring(0, 5) : '---';
        } catch(e) { return '---'; }
      })()
    align: center
  - name: ⚖️<br><small>Waga</small>
    data: rows
    modify: |-
      (function(){
        try {
          const hist = document.querySelector("home-assistant").hass.states['sensor.xiaomi_s400_history'];
          const rows = hist.attributes.rows;
          const target = x.ts * 1000;
          const closest = rows.reduce((p, c) =>
            Math.abs(c.ts * 1000 - target) < Math.abs(p.ts * 1000 - target) ? c : p);
          if (Math.abs(closest.ts * 1000 - target) > 7 * 24 * 3600000) return '---';
          return parseFloat(String(closest.weight)).toFixed(1);
        } catch(e){ return '---'; }
      })()
    align: center
  - name: 📊<br><small>RW</small>
    data: rows
    modify: |-
      (function(){
        try {
          const hist = document.querySelector("home-assistant").hass.states['sensor.xiaomi_s400_history'];
          const rows = hist.attributes.rows;
          const target = x.ts * 1000;
          const closest = rows.reduce((p, c) =>
            Math.abs(c.ts * 1000 - target) < Math.abs(p.ts * 1000 - target) ? c : p);
          if (Math.abs(closest.ts * 1000 - target) > 7 * 24 * 3600000) return '';
          const diff = parseFloat(String(closest.change));
          if (isNaN(diff)) return '';
          return diff >= 0.2 ? '⚠️' : (diff <= -0.2 ? '✅' : '➖');
        } catch(e){ return ''; }
      })()
    align: center
card_mod:
  style: |
    ha-card {
      max-height: 333px;
      overflow-y: auto;
      font-size: 12px;
      user-select: text !important;
      -webkit-user-select: text !important;
    }
    ha-card table {
      width: 100% !important;
      border-collapse: collapse;
      table-layout: auto;
    }
    ha-card thead th {
      text-align: center;
      vertical-align: bottom;
      padding: 2px 2px !important;
      line-height: 1.1;
      font-weight: bold;
      position: sticky;
      top: 0;
      background: var(--card-background-color);
      z-index: 2;
    }
    ha-card td {
      padding: 1px 2px !important;
      white-space: nowrap !important;
    }
    ha-card td:first-child,
    ha-card th:first-child {
      width: 1px;
    }
