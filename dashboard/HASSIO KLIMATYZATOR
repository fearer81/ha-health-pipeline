type: vertical-stack
cards:
  - type: conditional
    conditions:
      - condition: state
        entity: climate.klimatyzator
        state_not: dry
      - condition: state
        entity: climate.klimatyzator
        state_not: fan_only
    card:
      type: thermostat
      entity: climate.klimatyzator
      features:
        - type: climate-hvac-modes
          hvac_modes:
            - "off"
            - auto
            - cool
            - dry
            - fan_only
  - type: conditional
    conditions:
      - condition: state
        entity: climate.klimatyzator
        state: dry
    card:
      type: tile
      entity: climate.klimatyzator
      name: Osuszanie
      features:
        - type: climate-hvac-modes
          hvac_modes:
            - "off"
            - auto
            - cool
            - dry
            - fan_only
  - type: conditional
    conditions:
      - condition: state
        entity: climate.klimatyzator
        state: fan_only
    card:
      type: tile
      entity: climate.klimatyzator
      name: Nawiew
      features:
        - type: climate-hvac-modes
          hvac_modes:
            - "off"
            - auto
            - cool
            - dry
            - fan_only
  - type: conditional
    conditions:
      - condition: state
        entity: climate.klimatyzator
        state_not: "off"
    card:
      type: grid
      columns: 6
      square: false
      cards:
        - type: vertical-stack
          cards:
            - type: conditional
              conditions:
                - condition: state
                  entity: climate.klimatyzator
                  attribute: fan_mode
                  state: quiet
              card:
                type: button
                name: Quiet
                show_name: false
                icon: mdi:volume-mute
                color: yellow
                tap_action:
                  action: call-service
                  service: script.klimatyzator_quiet
            - type: conditional
              conditions:
                - condition: state
                  entity: climate.klimatyzator
                  attribute: fan_mode
                  state_not: quiet
              card:
                type: button
                name: Quiet
                show_name: false
                icon: mdi:volume-mute
                tap_action:
                  action: call-service
                  service: script.klimatyzator_quiet
        - type: vertical-stack
          cards:
            - type: conditional
              conditions:
                - condition: state
                  entity: climate.klimatyzator
                  attribute: fan_mode
                  state: sleep
              card:
                type: button
                name: Sleep
                show_name: false
                icon: mdi:bed-clock
                color: yellow
                tap_action:
                  action: call-service
                  service: script.klimatyzator_sleep
            - type: conditional
              conditions:
                - condition: state
                  entity: climate.klimatyzator
                  attribute: fan_mode
                  state_not: sleep
              card:
                type: button
                name: Sleep
                show_name: false
                icon: mdi:bed-clock
                tap_action:
                  action: call-service
                  service: script.klimatyzator_sleep
        - type: button
          name: Turbo Cool
          show_name: false
          icon: mdi:snowflake-alert
          tap_action:
            action: call-service
            service: script.klimatyzator_turbo
        - type: button
          name: Auto Full
          show_name: false
          icon: mdi:home-thermometer-outline
          tap_action:
            action: call-service
            service: script.klimatyzator_auto_full
        - type: button
          name: Swing Start
          show_name: false
          icon: mdi:fan-auto
