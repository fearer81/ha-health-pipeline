type: vertical-stack
cards:
  - type: thermostat
    entity: climate.klimatyzator
    features:
      - type: climate-hvac-modes
        hvac_modes:
          - "off"
          - auto
          - cool
          - dry
          - fan_only
  - type: conditional
    conditions:
      - condition: state
        entity: climate.klimatyzator
        state_not: "off"
    card:
      type: horizontal-stack
      cards:
        - type: button
          name: Quiet
          icon: mdi:volume-mute
          tap_action:
            action: call-service
            service: script.klimatyzator_quiet
