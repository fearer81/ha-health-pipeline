                      const hist = document.querySelector("home-assistant").hass.states['sensor.xiaomi_s400_history'];
                      const rows = hist.attributes.rows;
                      const target = x.ts * 1000;
                      const closest = rows.reduce((p, c) =>
                        Math.abs(c.ts * 1000 - target) < Math.abs(p.ts * 1000 - target) ? c : p);
                      if (Math.abs(closest.ts * 1000 - target) > 7 * 24 * 3600000) return '---';
                      return parseFloat(String(closest.weight)).toFixed(1);
                    } catch(e){ return '---'; }
                  })()
