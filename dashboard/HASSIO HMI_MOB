                      if (isNaN(s) || isNaN(d)) return;
                      const dt = new Date(r.ts * 1000);
                      pom.push({
                        dt: dt, s: s, d: d, pp: s - d,
                        puls: r.pulse ? parseInt(String(r.pulse).replace(' bpm', ''), 10) : null,
